<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="400"
    Height="475"
    x:Class="PasswordManager.Views.AddPasswordWindow"
    Title="Add Password">

    <!-- This lets me change the styles of the textboxes and the placeholder text -->
    <Window.Styles>
        <Style Selector="TextBox.error">
            <Setter Property="BorderBrush" Value="red" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="PlaceholderForeground" Value="red"/>
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
        Background="LightSlateGray"
        BorderBrush="black"
        BorderThickness="2"
        Margin="5">

        <Grid>
            <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="10" Orientation="Vertical" Spacing="10" Grid.Row="0">
                <TextBlock Text="Enter Password Information Here:"/>

                <TextBox Name="WebsiteTextBox" PlaceholderText="websitename.com"/>
                <TextBox Name="UsernameTextBox" PlaceholderText="username@gmail.com"/>

                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Name="PasswordTextBox" 
                    PlaceholderText="Enter password" 
                    PasswordChar="*"
                    Grid.Column="0"/>
                    
                    <Button Content="View" Name="ViewPasswordToggle"
                    Click="ViewPassword_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Grid.Column="1"
                    Margin="5, 0, 0, 0"/>
                </Grid>

                
                
                <StackPanel>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Text="Include Special Characters:" 
                        FontWeight="Bold"
                        FontSize="16"
                        VerticalAlignment="Center"
                        Margin="5,0,0,0"
                        Grid.Column="0"/>
                    
                        <ToggleSwitch Name="IncludeSpecialsToggleSwitch" 
                        OffContent=""
                        OnContent=""
                        IsChecked="False"
                        VerticalAlignment="Center"
                        Grid.Column="1"/>
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *, 45">
                        <TextBlock Text="Length:" 
                        FontWeight="Bold"
                        FontSize="14"
                        VerticalAlignment="Center"
                        Margin="5,0,10,0"
                        Grid.Column="0"/>

                        <Slider Name="PasswordLengthSlider" 
                        Minimum="8"
                        Maximum="32"
                        Value="16"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        Margin="0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        Grid.Column="1"/>

                        <TextBlock Text="{Binding Value, ElementName=PasswordLengthSlider, StringFormat={}{0:0}}"
                        FontWeight="Bold"
                        FontSize="16"
                        VerticalAlignment="Center"
                        Margin="15,0,0,0"
                        Grid.Column="2"/>
                    </Grid>
                </StackPanel>

                <Button Content="Generate Password" Click="GeneratePassword_Click"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"/>

                <TextBox Name="NotesTextBox" 
                PlaceholderText="Optional notes..."
                Height="100"
                TextWrapping="Wrap"
                AcceptsReturn="True"/>

            </StackPanel>
        </Grid>
            
        </Border>
        
        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Content="Save" Click="SaveNewPassword_Click" Grid.Column="0" HorizontalAlignment="Left" Width="75" HorizontalContentAlignment="Center"/>
            <Button Content="Close" Click="CloseNewPassword_Click" Grid.Column="1" HorizontalAlignment="Right" Width="75" HorizontalContentAlignment="Center"/>
        </Grid>

    </Grid>
    
</Window>